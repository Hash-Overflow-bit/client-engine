{
  "name": "client-engine",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @client-engine/web",
    "build": "npm run build --workspace @client-engine/web",
    "start": "npm run start --workspace @client-engine/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @client-engine/web",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run build",
    "lint": "eslint . --max-warnings=0",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
