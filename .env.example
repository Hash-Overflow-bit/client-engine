# Copy to apps/web/.env.local. Blank credentials mean not configured.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/worker only; never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
APOLLO_API_KEY=
AI_PROVIDER=ollama
AI_PROMPT_VERSION=qualification.v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_QUALIFICATION_ROUTINE_MODEL=
OPENAI_QUALIFICATION_STRONG_MODEL=
OUTBOUND_PROVIDER=
OUTBOUND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=
CALENDLY_BOOKING_URL=
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Reserved for the future dispatcher; no sender exists in this scaffold.
CLIENT_ENGINE_ENV=development
CLIENT_ENGINE_OPERATING_MODE=development
OUTREACH_MODE=approval
OUTREACH_SEND_ENABLED=false
OUTBOUND_KILL_SWITCH=true
OUTREACH_DAILY_LIMIT=10
# Controlled live testing is opt-in and may never exceed ten manually reviewed prospects.
LIVE_TEST_MODE=false
LIVE_TEST_MAX_PROSPECTS=10
